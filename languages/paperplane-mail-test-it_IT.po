msgid "Use export and import to move the list of monitored sites to another installation."
msgstr "Usa export e import per spostare la lista dei siti monitorati su un'altra installazione."

msgid "Export"
msgstr "Export"

msgid "Downloads a JSON file with all monitored sites and their secret keys. Keep this file safe."
msgstr "Scarica un file JSON con tutti i siti monitorati e le relative chiavi segrete. Conserva questo file in modo sicuro."

msgid "Download export file"
msgstr "Scarica il file di export"

msgid "Import"
msgstr "Import"

msgid "Upload an export file generated by this plugin. The secret keys in the file must already be configured on the respective client sites."
msgstr "Carica un file di export generato da questo plugin. Le chiavi segrete nel file devono essere già configurate sui rispettivi siti client."

msgid "Export file (.json)"
msgstr "File di export (.json)"

msgid "Import mode"
msgstr "Modalità di import"

msgid "Replace all existing sites"
msgstr "Sostituisci tutti i siti esistenti"

msgid "Add to existing sites"
msgstr "Aggiungi ai siti esistenti"

msgid "\"Replace\" will permanently delete all currently monitored sites."
msgstr "\"Sostituisci\" eliminerà definitivamente tutti i siti attualmente monitorati."

msgid "Upload error. Please try again."
msgstr "Errore nel caricamento. Riprova."

msgid "File too large. Maximum size is 256 KB."
msgstr "File troppo grande. La dimensione massima è 256 KB."

msgid "Invalid file type. Please upload a .json file."
msgstr "Tipo di file non valido. Carica un file .json."

msgid "Invalid file format. The file does not appear to be a valid PaperPlane Mail Monitor export."
msgstr "Formato file non valido. Il file non sembra essere un export valido di PaperPlane Mail Monitor."

msgid "No valid sites found in the file."
msgstr "Nessun sito valido trovato nel file."

msgid "Silent test address"
msgstr "Indirizzo test silenzioso"

msgid "Address that receives automatic cron test emails. Use a dedicated mailbox with a delete-all rule — this prevents inbox noise while keeping wp_mail() fully tested on each site."
msgstr "Indirizzo che riceve le mail di test automatiche del cron. Usa una casella dedicata con una regola elimina-tutto — evita il rumore nella posta in arrivo mantenendo wp_mail() testato su ogni sito."

msgid "Next check"
msgstr "Prossimo check"

msgid "Pending"
msgstr "In attesa"

msgid "Soon"
msgstr "Imminente"

msgid "PaperPlane Mail Test requires the PHP OpenSSL extension. Please enable it on your server and try again."
msgstr "PaperPlane Mail Test richiede l'estensione PHP OpenSSL. Abilitala sul server e riprova."
