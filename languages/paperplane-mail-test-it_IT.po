msgid "Save"
msgstr "Salva"

#: paperplane-mail-test.php:2195
msgid "Export / Import"
msgstr "Export / Import"

#: paperplane-mail-test.php:2196
msgid "Use export and import to move the list of monitored sites to another installation."
msgstr "Usa export e import per spostare la lista dei siti monitorati su un'altra installazione."

#: paperplane-mail-test.php:2198
msgid "Export"
msgstr "Export"

#: paperplane-mail-test.php:2199
msgid "Downloads a JSON file with all monitored sites. Secret keys are never exported in clear."
msgstr "Scarica un file JSON con tutti i siti monitorati. Le chiavi segrete non vengono mai esportate in chiaro."

#: paperplane-mail-test.php:2205 paperplane-mail-test.php:2208
msgid "Secret keys"
msgstr "Chiavi segrete"

#: paperplane-mail-test.php:2211
msgid "Protect with a password (recommended)"
msgstr "Proteggi con una password (consigliato)"

#: paperplane-mail-test.php:2215
msgid "Do not export the keys"
msgstr "Non esportare le chiavi"

#: paperplane-mail-test.php:2218
msgid "Without keys, after importing you will have to enter the key of each site with Edit."
msgstr "Senza chiavi, dopo l'import dovrai inserire la chiave di ogni sito con Modifica."

#: paperplane-mail-test.php:2222
msgid "Password"
msgstr "Password"

#: paperplane-mail-test.php:2225
#, php-format
msgid "At least %d characters. It will be asked when importing: keep it separate from the file (for example in a password manager), it cannot be recovered."
msgstr "Almeno %d caratteri. Verrà richiesta all'import: conservala separata dal file (per esempio in un password manager), non è recuperabile."

#: paperplane-mail-test.php:2229
msgid "Confirm password"
msgstr "Conferma password"

#: paperplane-mail-test.php:2233
msgid "Download export file"
msgstr "Scarica il file di export"

#: paperplane-mail-test.php:2236 paperplane-mail-test.php:2271
msgid "Import"
msgstr "Import"

#: paperplane-mail-test.php:2237
msgid "Upload an export file generated by this plugin. The secret keys in the file must still be the ones active on the respective client sites."
msgstr "Carica un file di export generato da questo plugin. Le chiavi segrete nel file devono essere ancora quelle attive sui rispettivi siti client."

#: paperplane-mail-test.php:2243
msgid "Export file (.json)"
msgstr "File di export (.json)"

#: paperplane-mail-test.php:2247
msgid "Export password"
msgstr "Password dell'export"

#: paperplane-mail-test.php:2250
msgid "Only for password-protected exports."
msgstr "Solo per gli export protetti da password."

