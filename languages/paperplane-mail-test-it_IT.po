msgstr "Attiva"

#: paperplane-mail-test.php:2266
msgid "Send a weekly summary email to alert recipients"
msgstr "Invia una mail di riepilogo settimanale ai destinatari degli avvisi"

#: paperplane-mail-test.php:2271
msgid "Day of the week"
msgstr "Giorno della settimana"

#: paperplane-mail-test.php:2276
