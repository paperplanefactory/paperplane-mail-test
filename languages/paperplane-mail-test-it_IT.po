msgstr "Mercoledì"

#: paperplane-mail-test.php:2279
msgid "Thursday"
msgstr "Giovedì"

#: paperplane-mail-test.php:2280
msgid "Friday"
msgstr "Venerdì"

#: paperplane-mail-test.php:2281
msgid "Saturday"
